<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- A menu-bar agent: no Dock tile and nothing on screen until the user
       asks for a window. set_dock_visibility(false) at startup does the same
       for `tauri dev`, which never reads this file. -->
  <key>LSUIElement</key>
  <true/>
  <!-- macOS 15 gates incoming LAN traffic (beacons, /p/*) behind the local
       network permission; without a reason string the prompt never shows and
       discovery silently gets nothing. -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>TieZ 需要在局域网内发现其他电脑并传输文件。</string>
</dict>
</plist>
