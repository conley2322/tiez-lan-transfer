<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Launch at login, registered with SMAppService (see
     src/infrastructure/macos_api/login_item.rs). Shipped inside the bundle so
     macOS shows it as TieZ rather than under the signing certificate's name.
     Paths are relative to the .app bundle. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tiez.autostart</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/tiez-app</string>
	<key>ProgramArguments</key>
	<array>
		<string>Contents/MacOS/tiez-app</string>
		<string>--minimized</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>com.tiez</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
